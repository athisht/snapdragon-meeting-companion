# Virtual Environments
venv*
.venv*

# Model Binaries & Large Artifacts (DO NOT COMMIT BINARIES TO GIT)
*.onnx
*.onnx_data
*.bin
*.weights
*.pt
*.pth
*.tflite
*.safetensors
*.ckpt

# Keep model directories tracked with .gitkeep
!models/**/.gitkeep

# Target Model folders content ignore
models/cpu/*/*
models/qnn/*/*
!models/cpu/*/.gitkeep
!models/qnn/*/.gitkeep

# Audio Recordings & Local Exports
*.wav
*.mp3
*.flac
*.m4a
exports/test_cli_meeting_notes.md
exports/*.json
exports/*.md
!exports/.gitkeep

# Environment variables & secrets
.env
.env.local

# IDEs & OS
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
