# Hardware Execution Provider Selection
# Options:
#   cpu  - Run on CPU (Default for x86 dev machines such as HP Victus)
#   qnn  - Run on Qualcomm Hexagon NPU (Snapdragon X Elite / Copilot+ PC)
#   cuda - Run on NVIDIA GPU (Optional)
EXECUTION_PROVIDER=cpu

# QNN Hexagon Tensor Processor DLL backend
QNN_HTP_DLL=QnnHtp.dll
